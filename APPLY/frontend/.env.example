# AKMIIS APPLY frontend — environment template
#
# Copy to .env and fill in. .env is gitignored; this file is not, so never put
# a real key in here.
#
# Create React App only exposes variables prefixed REACT_APP_, and reads them
# at BUILD time. Anything set here is compiled into the published JavaScript
# bundle and is therefore PUBLIC — never put a secret in a REACT_APP_ variable.

# The API's origin ONLY — no trailing slash and no /api suffix. Each call
# appends its own path, e.g. `${apiBaseUrl}/api/application/store`.
#   production  https://backend1.akmiis.com
#   local       http://localhost:8000
REACT_APP_API_URL=https://backend1.akmiis.com

# Google Maps key for the address step's location picker.
# Leave blank to build without the map; the form still submits.
# Restrict the key to the https://apply.akmiis.com referrer before use.
REACT_APP_GOOGLE_MAPS_API_KEY=
